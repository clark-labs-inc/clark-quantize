+            sumf = _mm256_fmadd_ps(_mm256_cvtepi32_ps(accumulator), scale, sumf);
+#else
+            sumf = _mm256_add_ps(sumf, _mm256_mul_ps(_mm256_cvtepi32_ps(accumulator), scale));
+#endif
+        }
+    }
+    *s = hsum_float_8(sumf);
