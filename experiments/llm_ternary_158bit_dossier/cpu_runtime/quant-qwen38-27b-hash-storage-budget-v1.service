[Unit]
Description=Count complete Qwen3.8-27B fixed-support hash storage bytes
After=network-online.target quant-qwen38-27b-fixed-support-codec-v1.service
Before=quant-qwen38-27b-hash-residual-cpu-v1.service quant-qwen38-27b-activation-hash-residual-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-hash-storage.bundle
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch_qwen38_27b_hash_storage_budget_v1.sh
CPUQuota=100%
MemoryMax=2G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
