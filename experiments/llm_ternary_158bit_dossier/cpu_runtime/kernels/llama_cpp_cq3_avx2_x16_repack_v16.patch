+void ggml_repack_cq3_0_to_cq3_0x16(
+        const block_cq3_0 * GGML_RESTRICT src,
+        block_cq3_0x16 * GGML_RESTRICT dst,
+        int rows,
+        int blocks_per_row) {
+    assert(rows > 0 && rows % 16 == 0);
+    assert(blocks_per_row > 0);
+    for (int row = 0; row < rows; row += 16) {
+        for (int ib = 0; ib < blocks_per_row; ++ib) {
+            block_cq3_0x16 * out = dst + (row/16)*blocks_per_row + ib;
+            for (int group = 0; group < 2; ++group) {
+                for (int lane = 0; lane < 16; ++lane) {
+                    const block_cq3_0 * in = src + (row + lane)*blocks_per_row + ib;
+                    out->d[group][lane] = in->d[group];
+                }
+                for (int chunk = 0; chunk < 8; ++chunk) {
+                    for (int lane = 0; lane < 16; ++lane) {
+                        const block_cq3_0 * in = src + (row + lane)*blocks_per_row + ib;
+                        memcpy(out->qs + group*512 + chunk*64 + lane*4,
+                                in->qs + group*32 + chunk*4, 4);
+                    }
+                }
+            }
+        }
+    }
+}
+
+#if defined(__AVX2__)
+static inline __m256i ggml_cq3_x16_chunk_dot_v16(
+        const __m256i packed,
+        const __m256i values0,
+        const __m256i values1,
+        const __m256i values2,
+        const __m256i values3,
+        const __m256i mask,
+        const __m256i ones) {
+    const __m256i digits0 = _mm256_and_si256(packed, mask);
+    const __m256i digits1 = _mm256_and_si256(_mm256_srli_epi16(packed, 2), mask);
+    const __m256i digits2 = _mm256_and_si256(_mm256_srli_epi16(packed, 4), mask);
+    const __m256i digits3 = _mm256_and_si256(_mm256_srli_epi16(packed, 6), mask);
+    const __m256i products01 = _mm256_add_epi16(
+            _mm256_maddubs_epi16(digits0, values0),
+            _mm256_maddubs_epi16(digits1, values1));
+    const __m256i products23 = _mm256_add_epi16(
+            _mm256_maddubs_epi16(digits2, values2),
+            _mm256_maddubs_epi16(digits3, values3));
+    return _mm256_madd_epi16(_mm256_add_epi16(products01, products23), ones);
+}
+#endif
+
+void ggml_gemv_cq3_0x16_cq8_0(
+        int n,
+        float * GGML_RESTRICT s,
+        const void * GGML_RESTRICT vx,
+        const void * GGML_RESTRICT vy,
+        int nr) {
+    assert(n % QK_CQ3_0 == 0);
+    assert(nr > 0 && nr % 16 == 0);
+#if defined(__AVX2__)
+    const block_cq3_0x16 * GGML_RESTRICT x = vx;
+    const block_cq8_0 * GGML_RESTRICT y = vy;
+    const int nb = n/QK_CQ3_0;
+    const __m256i mask = _mm256_set1_epi8(3);
+    const __m256i ones = _mm256_set1_epi16(1);
+    for (int row = 0; row < nr; row += 16) {
+        const block_cq3_0x16 * tile = x + (row/16)*nb;
+        __m256 sumf0 = _mm256_setzero_ps();
+        __m256 sumf1 = _mm256_setzero_ps();
+        for (int ib = 0; ib < nb; ++ib) {
+            for (int group = 0; group < 2; ++group) {
+                const block_cq8_0 * activation = y + 2*ib + group;
+                __m256i accumulator0 = _mm256_setzero_si256();
+                __m256i accumulator1 = _mm256_setzero_si256();
+                for (int chunk = 0; chunk < 8; ++chunk) {
+                    int32_t values_word0, values_word1, values_word2, values_word3;
+                    memcpy(&values_word0, activation->qs + chunk*4 +  0, 4);
+                    memcpy(&values_word1, activation->qs + chunk*4 + 32, 4);
+                    memcpy(&values_word2, activation->qs + chunk*4 + 64, 4);
+                    memcpy(&values_word3, activation->qs + chunk*4 + 96, 4);
+                    const __m256i values0 = _mm256_set1_epi32(values_word0);
+                    const __m256i values1 = _mm256_set1_epi32(values_word1);
+                    const __m256i values2 = _mm256_set1_epi32(values_word2);
+                    const __m256i values3 = _mm256_set1_epi32(values_word3);
+                    const uint8_t * packed = tile[ib].qs + group*512 + chunk*64;
+                    accumulator0 = _mm256_add_epi32(accumulator0,
+                            ggml_cq3_x16_chunk_dot_v16(_mm256_loadu_si256((const __m256i *) packed),
+                                    values0, values1, values2, values3, mask, ones));
+                    accumulator1 = _mm256_add_epi32(accumulator1,
+                            ggml_cq3_x16_chunk_dot_v16(_mm256_loadu_si256((const __m256i *) (packed + 32)),
+                                    values0, values1, values2, values3, mask, ones));
+                }
+                const __m256i activation_sum = _mm256_set1_epi32(activation->sum);
+                accumulator0 = _mm256_sub_epi32(accumulator0, activation_sum);
+                accumulator1 = _mm256_sub_epi32(accumulator1, activation_sum);
+                const __m256 activation_scale = _mm256_set1_ps(activation->d);
+                const __m256 scales0 = _mm256_mul_ps(
+                        _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (tile[ib].d[group] + 0))),
+                        activation_scale);
+                const __m256 scales1 = _mm256_mul_ps(
+                        _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (tile[ib].d[group] + 8))),
+                        activation_scale);
+#if defined(__FMA__)
+                sumf0 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(accumulator0), scales0, sumf0);
+                sumf1 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(accumulator1), scales1, sumf1);
+#else
+                sumf0 = _mm256_add_ps(sumf0, _mm256_mul_ps(_mm256_cvtepi32_ps(accumulator0), scales0));
+                sumf1 = _mm256_add_ps(sumf1, _mm256_mul_ps(_mm256_cvtepi32_ps(accumulator1), scales1));
+#endif
+            }
+        }
+        _mm256_storeu_ps(s + row + 0, sumf0);
+        _mm256_storeu_ps(s + row + 8, sumf1);
+    }
+#else
+    UNUSED(n);
+    UNUSED(s);
+    UNUSED(vx);
+    UNUSED(vy);
+    UNUSED(nr);
+    GGML_ABORT("CQ3_0x16 requires AVX2");
+#endif
+}
