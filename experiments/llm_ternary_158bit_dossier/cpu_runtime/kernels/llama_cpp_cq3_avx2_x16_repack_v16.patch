+static void test_x86_cq3_x16_repack() {
+    constexpr int rows = 32;
+    constexpr int columns = 512;
+    const int blocks_per_row = columns/QK_CQ3_0;
+    std::vector<float> source_row(columns), source_activation(columns);
+    std::vector<block_cq3_0> source((size_t) rows*blocks_per_row);
+    std::vector<block_cq3_0x8> repacked_x8((size_t) rows/8*blocks_per_row);
+    std::vector<block_cq3_0x16> repacked_x16((size_t) rows/16*blocks_per_row);
+    std::vector<block_cq8_0> activation(columns/QK_CQ8_0);
+    std::vector<float> ordinary(rows), output_x8(rows), output_x16(rows);
+    for (int row = 0; row < rows; ++row) {
+        qwen38_fill_cq3_bench_row(source_row.data(), columns, row, 0x16c03u);
+        quantize_row_cq3_0_ref(source_row.data(), source.data() + row*blocks_per_row, columns);
+    }
+    for (int column = 0; column < columns; ++column) {
+        source_activation[column] = (float) (((column*47 + 31) % 253) - 126)/49.0f;
+    }
+    quantize_row_cq8_0_ref(source_activation.data(), activation.data(), columns);
+    ggml_repack_cq3_0_to_cq3_0x8(source.data(), repacked_x8.data(), rows, blocks_per_row);
+    ggml_repack_cq3_0_to_cq3_0x16(source.data(), repacked_x16.data(), rows, blocks_per_row);
+    static_assert(sizeof(block_cq3_0x16) == 16*sizeof(block_cq3_0), "storage expansion");
+    for (int row = 0; row < rows; ++row) {
+        for (int ib = 0; ib < blocks_per_row; ++ib) {
+            const block_cq3_0 & ordinary_block = source[row*blocks_per_row + ib];
+            const block_cq3_0x16 & tile = repacked_x16[(row/16)*blocks_per_row + ib];
+            for (int group = 0; group < 2; ++group) {
+                assert(ordinary_block.d[group] == tile.d[group][row % 16]);
+                for (int lane = 0; lane < 32; ++lane) {
+                    const int chunk = lane/4;
+                    const int offset = lane % 4;
+                    assert(ordinary_block.qs[group*32 + lane] ==
+                            tile.qs[group*512 + chunk*64 + (row % 16)*4 + offset]);
+                }
+            }
+        }
+        ggml_vec_dot_cq3_0_cq8_0(columns, ordinary.data() + row, 0,
+                source.data() + row*blocks_per_row, 0, activation.data(), 0, 1);
+    }
+    ggml_gemv_cq3_0x8_cq8_0(columns, output_x8.data(), repacked_x8.data(), activation.data(), rows);
+    ggml_gemv_cq3_0x16_cq8_0(columns, output_x16.data(), repacked_x16.data(), activation.data(), rows);
+    assert(std::memcmp(output_x8.data(), output_x16.data(), rows*sizeof(float)) == 0);
+    for (int row = 0; row < rows; ++row) {
+        assert(std::isfinite(output_x16[row]));
+        assert(qwen38_cq3_scaled_delta(ordinary[row], output_x16[row]) <= 5e-5f);
+    }
+}
+
+static void qwen38_evict_cq3_x16_cache(std::vector<uint8_t> & cache) {
+    static uint8_t epoch = 197;
+    for (size_t offset = 0; offset < cache.size(); offset += 64) {
+        cache[offset] = (uint8_t) (cache[offset] + epoch);
+    }
+    ++epoch;
+}
+
+static double qwen38_cq3_x16_median(std::vector<double> values) {
+    std::sort(values.begin(), values.end());
+    return values[values.size()/2];
+}
+
+static void qwen38_print_cq3_x16_values(const std::vector<double> & values) {
+    std::printf("[");
+    for (size_t index = 0; index < values.size(); ++index) {
+        std::printf(index == 0 ? "%.3f" : ",%.3f", values[index]);
+    }
+    std::printf("]");
+}
+
+static void run_qwen38_27b_cq3_x16_repack_benchmark() {
+    constexpr int rows = 17408;
+    constexpr int columns = 5120;
+    constexpr int warmups = 2;
+    constexpr int repetitions = 9;
+    constexpr size_t cache_eviction_bytes = 256u*1024u*1024u;
+    const int blocks_per_row = columns/QK_CQ3_0;
+    std::vector<block_cq3_0> gate_weights((size_t) rows*blocks_per_row);
+    std::vector<block_cq3_0> up_weights((size_t) rows*blocks_per_row);
+    std::vector<block_cq3_0x8> gate_x8((size_t) rows/8*blocks_per_row);
+    std::vector<block_cq3_0x8> up_x8((size_t) rows/8*blocks_per_row);
+    std::vector<block_cq3_0x16> gate_x16((size_t) rows/16*blocks_per_row);
+    std::vector<block_cq3_0x16> up_x16((size_t) rows/16*blocks_per_row);
+    std::vector<block_cq8_0> activation(columns/QK_CQ8_0);
+    std::vector<float> source_row(columns), source_activation(columns);
+    std::vector<float> ordinary_gate(rows), ordinary_up(rows);
+    std::vector<float> output_x8_gate(rows), output_x8_up(rows);
+    std::vector<float> output_x16_gate(rows), output_x16_up(rows);
+    std::vector<uint8_t> eviction(cache_eviction_bytes);
+    for (int row = 0; row < rows; ++row) {
+        qwen38_fill_cq3_bench_row(source_row.data(), columns, row, 0x13579bdu);
+        quantize_row_cq3_0_ref(source_row.data(), gate_weights.data() + row*blocks_per_row, columns);
+        qwen38_fill_cq3_bench_row(source_row.data(), columns, row, 0x2468aceu);
+        quantize_row_cq3_0_ref(source_row.data(), up_weights.data() + row*blocks_per_row, columns);
+    }
+    for (int column = 0; column < columns; ++column) {
+        source_activation[column] = (float) (((column*37 + 17) % 255) - 127)/53.0f;
+    }
+    quantize_row_cq8_0_ref(source_activation.data(), activation.data(), columns);
+    ggml_repack_cq3_0_to_cq3_0x8(gate_weights.data(), gate_x8.data(), rows, blocks_per_row);
+    ggml_repack_cq3_0_to_cq3_0x8(up_weights.data(), up_x8.data(), rows, blocks_per_row);
+    const auto repack_start = std::chrono::steady_clock::now();
+    ggml_repack_cq3_0_to_cq3_0x16(gate_weights.data(), gate_x16.data(), rows, blocks_per_row);
+    ggml_repack_cq3_0_to_cq3_0x16(up_weights.data(), up_x16.data(), rows, blocks_per_row);
+    const auto repack_stop = std::chrono::steady_clock::now();
+    const double repack_us = std::chrono::duration<double, std::micro>(repack_stop - repack_start).count();
+    auto run_ordinary = [&]() {
+        qwen38_run_cq3_x8_control(rows, columns, gate_weights.data(), activation.data(), ordinary_gate.data());
+        qwen38_run_cq3_x8_control(rows, columns, up_weights.data(), activation.data(), ordinary_up.data());
+    };
+    auto run_x8 = [&]() {
+        ggml_gemv_cq3_0x8_cq8_0(columns, output_x8_gate.data(), gate_x8.data(), activation.data(), rows);
+        ggml_gemv_cq3_0x8_cq8_0(columns, output_x8_up.data(), up_x8.data(), activation.data(), rows);
+    };
+    auto run_x16 = [&]() {
+        ggml_gemv_cq3_0x16_cq8_0(columns, output_x16_gate.data(), gate_x16.data(), activation.data(), rows);
+        ggml_gemv_cq3_0x16_cq8_0(columns, output_x16_up.data(), up_x16.data(), activation.data(), rows);
+    };
+    run_ordinary(); run_x8(); run_x16();
+    assert(std::memcmp(output_x8_gate.data(), output_x16_gate.data(), rows*sizeof(float)) == 0);
+    assert(std::memcmp(output_x8_up.data(), output_x16_up.data(), rows*sizeof(float)) == 0);
+    float max_scaled_delta = 0.0f;
+    for (int row = 0; row < rows; ++row) {
+        max_scaled_delta = std::max(max_scaled_delta, qwen38_cq3_scaled_delta(ordinary_gate[row], output_x16_gate[row]));
+        max_scaled_delta = std::max(max_scaled_delta, qwen38_cq3_scaled_delta(ordinary_up[row], output_x16_up[row]));
+    }
+    assert(max_scaled_delta <= 5e-5f);
+    for (int warmup = 0; warmup < warmups; ++warmup) { run_ordinary(); run_x8(); run_x16(); }
+    std::vector<double> ordinary_us, x8_us, x16_us;
+    volatile float sink = 0.0f;
+    auto measure = [&](auto && run, const std::vector<float> & gate, const std::vector<float> & up) {
+        qwen38_evict_cq3_x16_cache(eviction);
+        const auto start = std::chrono::steady_clock::now();
+        run();
+        const auto stop = std::chrono::steady_clock::now();
+        sink += gate[0] + up[rows - 1];
+        return std::chrono::duration<double, std::micro>(stop - start).count();
+    };
+    for (int repetition = 0; repetition < repetitions; ++repetition) {
+        if (repetition % 3 == 0) {
+            ordinary_us.push_back(measure(run_ordinary, ordinary_gate, ordinary_up));
+            x8_us.push_back(measure(run_x8, output_x8_gate, output_x8_up));
+            x16_us.push_back(measure(run_x16, output_x16_gate, output_x16_up));
+        } else if (repetition % 3 == 1) {
+            x16_us.push_back(measure(run_x16, output_x16_gate, output_x16_up));
+            x8_us.push_back(measure(run_x8, output_x8_gate, output_x8_up));
+            ordinary_us.push_back(measure(run_ordinary, ordinary_gate, ordinary_up));
+        } else {
+            x8_us.push_back(measure(run_x8, output_x8_gate, output_x8_up));
+            ordinary_us.push_back(measure(run_ordinary, ordinary_gate, ordinary_up));
+            x16_us.push_back(measure(run_x16, output_x16_gate, output_x16_up));
+        }
+    }
+    const double ordinary_median = qwen38_cq3_x16_median(ordinary_us);
+    const double x8_median = qwen38_cq3_x16_median(x8_us);
+    const double x16_median = qwen38_cq3_x16_median(x16_us);
+    std::printf("{\"schema\":\"qwen38_27b_cq3_x16_repack_benchmark_v16\",");
+    std::printf("\"rows_per_matrix\":%d,\"matrices\":2,\"columns\":%d,", rows, columns);
+    std::printf("\"warmups\":%d,\"repetitions\":%d,\"cache_eviction_bytes\":%zu,", warmups, repetitions, cache_eviction_bytes);
+    std::printf("\"source_bytes\":%zu,\"x8_bytes\":%zu,\"x16_bytes\":%zu,\"x16_repack_us\":%.3f,",
+            2*gate_weights.size()*sizeof(block_cq3_0), 2*gate_x8.size()*sizeof(block_cq3_0x8),
+            2*gate_x16.size()*sizeof(block_cq3_0x16), repack_us);
+    std::printf("\"x8_x16_bit_exact\":true,\"max_scaled_delta_vs_ordinary\":%.9g,", (double) max_scaled_delta);
+    std::printf("\"ordinary_us\":"); qwen38_print_cq3_x16_values(ordinary_us);
+    std::printf(",\"x8_us\":"); qwen38_print_cq3_x16_values(x8_us);
+    std::printf(",\"x16_us\":"); qwen38_print_cq3_x16_values(x16_us);
