+static int32_t qwen38_cq3_source_integer_group_dot(
+        const block_cq3_0 & weight,
+        int group,
+        const block_cq8_0 & activation) {
+    int32_t sum = 0;
+    for (int lane = 0; lane < 32; ++lane) {
+        const uint8_t packed = weight.qs[group*32 + lane];
+        for (int quarter = 0; quarter < 4; ++quarter) {
+            const int digit = (packed >> (2*quarter)) & 3;
+            assert(digit < 3);
+            sum += (digit - 1)*(int32_t) activation.qs[quarter*32 + lane];
+        }
+    }
+    return sum;
+}
+
+static int32_t qwen38_cq3_x8_integer_group_dot(
+        const block_cq3_0x8 & weight,
+        int row,
+        int group,
+        const block_cq8_0 & activation) {
+    int32_t sum = 0;
+    for (int lane = 0; lane < 32; ++lane) {
+        const int chunk = lane/4;
+        const int offset = lane % 4;
+        const uint8_t packed = weight.qs[group*256 + chunk*32 + row*4 + offset];
+        for (int quarter = 0; quarter < 4; ++quarter) {
+            const int digit = (packed >> (2*quarter)) & 3;
+            assert(digit < 3);
+            sum += (digit - 1)*(int32_t) activation.qs[quarter*32 + lane];
+        }
+    }
+    return sum;
+}
+
+static float qwen38_cq3_scaled_delta(float control, float candidate) {
+    return std::fabs(control - candidate)/std::max(1.0f, std::fabs(control));
+}
+
+static void test_x86_cq3_x8_repack() {
+    constexpr int rows = 16;
+    constexpr int columns = 512;
+    const int blocks_per_row = columns/QK_CQ3_0;
+    std::vector<float> source_row(columns);
+    std::vector<float> source_activation(columns);
+    std::vector<block_cq3_0> source((size_t) rows*blocks_per_row);
+    std::vector<block_cq3_0x8> repacked((size_t) rows/8*blocks_per_row);
+    std::vector<block_cq8_0> activation(columns/QK_CQ8_0);
+    std::vector<float> control(rows);
+    std::vector<float> candidate(rows);
+    for (int row = 0; row < rows; ++row) {
+        qwen38_fill_cq3_bench_row(source_row.data(), columns, row, 0x5a17c3u);
+        quantize_row_cq3_0_ref(source_row.data(), source.data() + row*blocks_per_row, columns);
+    }
+    for (int column = 0; column < columns; ++column) {
+        source_activation[column] = (float) (((column*43 + 29) % 251) - 125)/47.0f;
+    }
+    quantize_row_cq8_0_ref(source_activation.data(), activation.data(), columns);
+    ggml_repack_cq3_0_to_cq3_0x8(source.data(), repacked.data(), rows, blocks_per_row);
+    static_assert(sizeof(block_cq3_0x8) == 8*sizeof(block_cq3_0), "storage expansion");
+    for (int row = 0; row < rows; ++row) {
+        for (int ib = 0; ib < blocks_per_row; ++ib) {
+            const block_cq3_0 & ordinary = source[row*blocks_per_row + ib];
+            const block_cq3_0x8 & tile = repacked[(row/8)*blocks_per_row + ib];
+            for (int group = 0; group < 2; ++group) {
+                assert(ordinary.d[group] == tile.d[group][row % 8]);
+                assert(qwen38_cq3_source_integer_group_dot(
+                        ordinary, group, activation[2*ib + group]) ==
+                        qwen38_cq3_x8_integer_group_dot(
+                        tile, row % 8, group, activation[2*ib + group]));
+                for (int lane = 0; lane < 32; ++lane) {
+                    const int chunk = lane/4;
+                    const int offset = lane % 4;
+                    assert(ordinary.qs[group*32 + lane] ==
+                            tile.qs[group*256 + chunk*32 + (row % 8)*4 + offset]);
+                }
+            }
+        }
+        ggml_vec_dot_cq3_0_cq8_0(columns, control.data() + row, 0,
+                source.data() + row*blocks_per_row, 0, activation.data(), 0, 1);
+    }
+    ggml_gemv_cq3_0x8_cq8_0(columns, candidate.data(), repacked.data(), activation.data(), rows);
+    for (int row = 0; row < rows; ++row) {
+        assert(std::isfinite(candidate[row]));
+        assert(qwen38_cq3_scaled_delta(control[row], candidate[row]) <= 5e-5f);
+    }
+}
+
+static void qwen38_run_cq3_x8_control(
+        int rows,
+        int columns,
+        const block_cq3_0 * weights,
+        const block_cq8_0 * activation,
+        float * output) {
+    const int blocks_per_row = columns/QK_CQ3_0;
+    for (int row = 0; row < rows; ++row) {
+        ggml_vec_dot_cq3_0_cq8_0(columns, output + row, 0,
+                weights + row*blocks_per_row, 0, activation, 0, 1);
+    }
+}
+
+static void qwen38_evict_cq3_x8_cache(std::vector<uint8_t> & cache) {
+    static uint8_t epoch = 113;
+    for (size_t offset = 0; offset < cache.size(); offset += 64) {
+        cache[offset] = (uint8_t) (cache[offset] + epoch);
+    }
+    ++epoch;
+}
+
+static double qwen38_cq3_x8_median(std::vector<double> values) {
+    std::sort(values.begin(), values.end());
+    return values[values.size()/2];
+}
+
+static void qwen38_print_cq3_x8_values(const std::vector<double> & values) {
+    std::printf("[");
+    for (size_t index = 0; index < values.size(); ++index) {
+        std::printf(index == 0 ? "%.3f" : ",%.3f", values[index]);
+    }
+    std::printf("]");
+}
+
+static void run_qwen38_27b_cq3_x8_repack_benchmark() {
+    constexpr int rows = 17408;
+    constexpr int columns = 5120;
+    constexpr int warmups = 2;
+    constexpr int repetitions = 9;
+    constexpr size_t cache_eviction_bytes = 256u*1024u*1024u;
+    const int blocks_per_row = columns/QK_CQ3_0;
+    std::vector<block_cq3_0> gate_weights((size_t) rows*blocks_per_row);
+    std::vector<block_cq3_0> up_weights((size_t) rows*blocks_per_row);
+    std::vector<block_cq3_0x8> gate_repacked((size_t) rows/8*blocks_per_row);
+    std::vector<block_cq3_0x8> up_repacked((size_t) rows/8*blocks_per_row);
+    std::vector<block_cq8_0> activation(columns/QK_CQ8_0);
+    std::vector<float> source_row(columns);
+    std::vector<float> source_activation(columns);
+    std::vector<float> control_gate(rows), control_up(rows);
+    std::vector<float> candidate_gate(rows), candidate_up(rows);
+    std::vector<uint8_t> eviction(cache_eviction_bytes);
+    for (int row = 0; row < rows; ++row) {
+        qwen38_fill_cq3_bench_row(source_row.data(), columns, row, 0x13579bdu);
+        quantize_row_cq3_0_ref(source_row.data(), gate_weights.data() + row*blocks_per_row, columns);
+        qwen38_fill_cq3_bench_row(source_row.data(), columns, row, 0x2468aceu);
+        quantize_row_cq3_0_ref(source_row.data(), up_weights.data() + row*blocks_per_row, columns);
+    }
+    for (int column = 0; column < columns; ++column) {
+        source_activation[column] = (float) (((column*37 + 17) % 255) - 127)/53.0f;
+    }
+    quantize_row_cq8_0_ref(source_activation.data(), activation.data(), columns);
+    const auto repack_start = std::chrono::steady_clock::now();
+    ggml_repack_cq3_0_to_cq3_0x8(gate_weights.data(), gate_repacked.data(), rows, blocks_per_row);
+    ggml_repack_cq3_0_to_cq3_0x8(up_weights.data(), up_repacked.data(), rows, blocks_per_row);
+    const auto repack_stop = std::chrono::steady_clock::now();
+    const double repack_us = std::chrono::duration<double, std::micro>(repack_stop - repack_start).count();
+    auto run_control = [&]() {
+        qwen38_run_cq3_x8_control(rows, columns, gate_weights.data(), activation.data(), control_gate.data());
+        qwen38_run_cq3_x8_control(rows, columns, up_weights.data(), activation.data(), control_up.data());
+    };
+    auto run_candidate = [&]() {
+        ggml_gemv_cq3_0x8_cq8_0(columns, candidate_gate.data(), gate_repacked.data(), activation.data(), rows);
+        ggml_gemv_cq3_0x8_cq8_0(columns, candidate_up.data(), up_repacked.data(), activation.data(), rows);
+    };
+    run_control();
+    run_candidate();
+    float max_abs_delta = 0.0f;
+    float max_scaled_delta = 0.0f;
+    for (int row = 0; row < rows; ++row) {
+        max_abs_delta = std::max(max_abs_delta, std::fabs(control_gate[row] - candidate_gate[row]));
+        max_abs_delta = std::max(max_abs_delta, std::fabs(control_up[row] - candidate_up[row]));
+        max_scaled_delta = std::max(max_scaled_delta, qwen38_cq3_scaled_delta(control_gate[row], candidate_gate[row]));
+        max_scaled_delta = std::max(max_scaled_delta, qwen38_cq3_scaled_delta(control_up[row], candidate_up[row]));
+    }
+    assert(max_scaled_delta <= 5e-5f);
+    for (int warmup = 0; warmup < warmups; ++warmup) {
+        run_control();
+        run_candidate();
+    }
+    std::vector<double> control_us, candidate_us;
+    volatile float sink = 0.0f;
+    auto measure_control = [&]() {
+        qwen38_evict_cq3_x8_cache(eviction);
+        const auto start = std::chrono::steady_clock::now();
+        run_control();
+        const auto stop = std::chrono::steady_clock::now();
+        sink += control_gate[0] + control_up[rows - 1];
+        return std::chrono::duration<double, std::micro>(stop - start).count();
+    };
+    auto measure_candidate = [&]() {
+        qwen38_evict_cq3_x8_cache(eviction);
+        const auto start = std::chrono::steady_clock::now();
+        run_candidate();
+        const auto stop = std::chrono::steady_clock::now();
+        sink += candidate_gate[0] + candidate_up[rows - 1];
+        return std::chrono::duration<double, std::micro>(stop - start).count();
+    };
+    for (int repetition = 0; repetition < repetitions; ++repetition) {
+        if ((repetition & 1) == 0) {
+            control_us.push_back(measure_control());
+            candidate_us.push_back(measure_candidate());
+        } else {
+            candidate_us.push_back(measure_candidate());
+            control_us.push_back(measure_control());
+        }
+    }
+    const double control_median = qwen38_cq3_x8_median(control_us);
+    const double candidate_median = qwen38_cq3_x8_median(candidate_us);
+    std::printf("{\"schema\":\"qwen38_27b_cq3_x8_repack_benchmark_v15\",");
+    std::printf("\"rows_per_matrix\":%d,\"matrices\":2,\"columns\":%d,", rows, columns);
+    std::printf("\"warmups\":%d,\"repetitions\":%d,\"cache_eviction_bytes\":%zu,", warmups, repetitions, cache_eviction_bytes);
+    std::printf("\"source_bytes\":%zu,\"runtime_bytes\":%zu,\"repack_us\":%.3f,",
+            2*gate_weights.size()*sizeof(block_cq3_0), 2*gate_repacked.size()*sizeof(block_cq3_0x8), repack_us);
+    std::printf("\"max_abs_delta\":%.9g,\"max_scaled_delta\":%.9g,\"control_us\":", (double) max_abs_delta, (double) max_scaled_delta);
+    qwen38_print_cq3_x8_values(control_us);
+    std::printf(",\"candidate_us\":");
+    qwen38_print_cq3_x8_values(candidate_us);
+    std::printf(",\"control_median_us\":%.3f,\"candidate_median_us\":%.3f,", control_median, candidate_median);
+    std::printf("\"speedup\":%.8f,\"sink\":%.9g}\n", control_median/candidate_median, (double) sink);
+}
