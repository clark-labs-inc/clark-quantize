+// Runtime-only output-row interleave for eight CQ3_0 blocks. It is a bytewise
+// permutation of eight source blocks: no trits or scales are expanded.
+typedef struct {
+    ggml_half d[2][8];
+    uint8_t qs[8*QK_CQ3_0/4];
+} block_cq3_0x8;
+static_assert(sizeof(block_cq3_0x8) == 8*sizeof(block_cq3_0),
+        "CQ3_0x8 must remain storage neutral");
+
 // Ephemeral A8 companion for CQ3_0. The sum permits centering unsigned
 // ternary digits (0, 1, 2) without materializing signed weights.
 #define QK_CQ8_0 128
