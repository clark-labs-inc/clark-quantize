+void ggml_repack_q8_K_4x8_to_q8_K_rows(const void * GGML_RESTRICT vx,
+                                       void * GGML_RESTRICT vy,
+                                       int64_t k) {
+    assert(QK_K == 256);
+    assert(k % QK_K == 0);
 
+    const int nb = k / QK_K;
+    const block_q8_Kx4 * GGML_RESTRICT x = (const block_q8_Kx4 *) vx;
+    block_q8_K * GGML_RESTRICT y = (block_q8_K *) vy;
+
+    static_assert(sizeof(block_q8_Kx4) == 4 * sizeof(block_q8_K));
+
+    for (int b = 0; b < nb; ++b) {
+        for (int row = 0; row < 4; ++row) {
+            block_q8_K & dst = y[row * nb + b];
+            dst.d = x[b].d[row];
+            for (int group16 = 0; group16 < QK_K / 16; ++group16) {
+                const int tiled = (group16 / 4) * 16 + row * 4 + (group16 % 4);
+                dst.bsums[group16] = x[b].bsums[tiled];
+            }
+
+            // Native 4x8 Q8_K stores one eight-byte group from each row in
+            // every 32-byte vector.  Constant-size copies compile to scalar
+            // 64-bit loads/stores on AVX2 and preserve every signed code bit.
+            for (int group8 = 0; group8 < QK_K / 8; ++group8) {
+                memcpy(dst.qs + group8 * 8,
+                       x[b].qs + group8 * 32 + row * 8,
+                       8);
+            }
+        }
+    }
+}
