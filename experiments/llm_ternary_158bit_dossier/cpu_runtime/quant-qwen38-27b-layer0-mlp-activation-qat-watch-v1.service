[Unit]
Description=Wait for Qwen3.8-27B control gates, then run bounded layer-0 activation QAT
After=network-online.target quant-qwen38-27b-infrastructure-retry-v1.service quant-qwen38-27b-activation-hash-residual-v1.service quant-qwen38-27b-row-scale-pipeline-v2.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-activation-qat.bundle
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch_qwen38_27b_layer0_mlp_activation_qat_v1.sh
CPUQuota=400%
MemoryMax=29G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
