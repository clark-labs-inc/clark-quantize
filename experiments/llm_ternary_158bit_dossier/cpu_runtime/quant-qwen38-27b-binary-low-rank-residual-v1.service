[Unit]
Description=Screen a full Qwen3.8-27B gate/up binary low-rank residual
After=network-online.target quant-qwen38-27b-infrastructure-retry-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-binary-low-rank-v1
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-binary-low-rank.bundle
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch_qwen38_27b_binary_low_rank_residual_v1.sh
CPUQuota=800%
MemoryMax=12G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
