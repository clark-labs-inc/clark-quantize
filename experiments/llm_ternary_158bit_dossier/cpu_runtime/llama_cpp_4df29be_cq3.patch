+static int cq3_descending_float(const void * lhs, const void * rhs) {
+    const float a = *(const float *) lhs;
+    const float b = *(const float *) rhs;
+    return (a < b) - (a > b);
+}
+
+void quantize_row_cq3_0_ref(const float * GGML_RESTRICT x, block_cq3_0 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_CQ3_0 == 0);
+    const int64_t nb = k / QK_CQ3_0;
+
+    for (int64_t ib = 0; ib < nb; ++ib) {
+        for (int group = 0; group < 2; ++group) {
+            const float * values = x + ib*QK_CQ3_0 + group*QK_CQ8_0;
+            float ordered[QK_CQ8_0];
+            for (int j = 0; j < QK_CQ8_0; ++j) {
+                ordered[j] = fabsf(values[j]);
+            }
+            qsort(ordered, QK_CQ8_0, sizeof(float), cq3_descending_float);
+
+            float prefix = 0.0f;
+            float best_prefix = 0.0f;
+            float best_score = -1.0f;
+            int best = 0;
+            for (int j = 0; j < QK_CQ8_0; ++j) {
+                prefix += ordered[j];
+                const float score = prefix*prefix/(float)(j + 1);
+                if (score > best_score) {
+                    best_score = score;
+                    best_prefix = prefix;
+                    best = j;
+                }
+            }
+
+            const float threshold = ordered[best];
+            const float scale = MAX(best_prefix/(float)(best + 1), 1e-8f);
+            y[ib].d[group] = GGML_FP32_TO_FP16(scale);
+
+            for (int lane = 0; lane < 32; ++lane) {
+                uint8_t packed = 0;
+                for (int quarter = 0; quarter < 4; ++quarter) {
+                    const float value = values[quarter*32 + lane];
+                    const int code = fabsf(value) >= threshold ? (value > 0.0f) - (value < 0.0f) : 0;
+                    packed |= (uint8_t)(code + 1) << (2*quarter);
+                }
+                y[ib].qs[group*32 + lane] = packed;
+            }
+        }
+    }
+}
+
+void quantize_row_cq8_0_ref(const float * GGML_RESTRICT x, block_cq8_0 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_CQ8_0 == 0);
+    const int64_t nb = k / QK_CQ8_0;
+
+    for (int64_t ib = 0; ib < nb; ++ib) {
+        float amax = 0.0f;
+        for (int j = 0; j < QK_CQ8_0; ++j) {
+            amax = MAX(amax, fabsf(x[ib*QK_CQ8_0 + j]));
+        }
+        const float d = amax == 0.0f ? 1.0f : amax/127.0f;
+        const float id = 1.0f/d;
+        int32_t sum = 0;
+        for (int j = 0; j < QK_CQ8_0; ++j) {
+            int q = (int) lrintf(x[ib*QK_CQ8_0 + j]*id);
+            q = MAX(-127, MIN(127, q));
+            y[ib].qs[j] = (int8_t) q;
+            sum += q;
+        }
+        y[ib].d = d;
+        y[ib].sum = sum;
+    }
+}
