diff --git a/tests/test-cq3.cpp b/tests/test-cq3.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..336e047a097cd48291f68ca935735170eb3e0a46
--- /dev/null
+++ b/tests/test-cq3.cpp
@@ -0,0 +1,117 @@
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "ggml-quants.h"
+#include "ggml-cpu/quants.h"
+
+#include <algorithm>
+#undef NDEBUG
+#include <assert.h>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+static void test_layout_and_decode() {
+    static_assert(sizeof(block_cq3_0) == 68, "CQ3_0 must remain 2.125 bits/weight");
+    static_assert(sizeof(block_cq8_0) == 136, "CQ8_0 contract changed");
+
+    block_cq3_0 block = {};
+    block.d[0] = 0x3c00; // fp16 1.0
+    block.d[1] = 0x4000; // fp16 2.0
+    for (int group = 0; group < 2; ++group) {
+        for (int lane = 0; lane < 32; ++lane) {
+            uint8_t packed = 0;
+            for (int quarter = 0; quarter < 4; ++quarter) {
+                const int logical = quarter*32 + lane;
+                const int code = logical % 3 - 1;
+                packed |= (uint8_t)(code + 1) << (2*quarter);
+            }
+            block.qs[group*32 + lane] = packed;
+        }
+    }
+
+    float decoded[QK_CQ3_0];
+    dequantize_row_cq3_0(&block, decoded, QK_CQ3_0);
+    for (int group = 0; group < 2; ++group) {
+        const float scale = group == 0 ? 1.0f : 2.0f;
+        for (int j = 0; j < QK_CQ8_0; ++j) {
+            assert(decoded[group*QK_CQ8_0 + j] == (float)(j % 3 - 1)*scale);
+        }
+    }
+    assert(ggml_validate_row_data(GGML_TYPE_CQ3_0, &block, sizeof(block)));
+    block.qs[0] = (block.qs[0] & ~3u) | 3u;
+    assert(!ggml_validate_row_data(GGML_TYPE_CQ3_0, &block, sizeof(block)));
+}
+
+static void test_activation_contract() {
+    float zeros[QK_CQ8_0] = {};
+    block_cq8_0 block;
+    quantize_row_cq8_0_ref(zeros, &block, QK_CQ8_0);
+    assert(block.d == 1.0f);
+    assert(block.sum == 0);
+    for (int j = 0; j < QK_CQ8_0; ++j) {
+        assert(block.qs[j] == 0);
+    }
+
+    std::vector<float> values(QK_CQ8_0);
+    for (int j = 0; j < QK_CQ8_0; ++j) {
+        values[j] = 2.75f*std::sin(0.37f*(float)j) + 0.125f*std::cos(0.11f*(float)j);
+    }
+    quantize_row_cq8_0_ref(values.data(), &block, QK_CQ8_0);
+    const float maximum = *std::max_element(values.begin(), values.end(), [](float a, float b) {
+        return std::fabs(a) < std::fabs(b);
+    });
+    assert(std::fabs(block.d - std::fabs(maximum)/127.0f) < 1e-7f);
+    int32_t sum = 0;
+    for (int j = 0; j < QK_CQ8_0; ++j) {
+        sum += block.qs[j];
+    }
+    assert(sum == block.sum);
+}
+
+static void test_determinism_and_dot() {
+    constexpr int n = 4096;
+    std::vector<float> weights(n);
+    std::vector<float> activations(n);
+    for (int j = 0; j < n; ++j) {
+        weights[j] = 1.7f*std::sin(0.013f*(float)j) + 0.31f*std::cos(0.071f*(float)j);
+        activations[j] = 2.1f*std::cos(0.017f*(float)j) - 0.27f*std::sin(0.097f*(float)j);
+    }
+
+    std::vector<block_cq3_0> w0(n/QK_CQ3_0);
+    std::vector<block_cq3_0> w1(n/QK_CQ3_0);
+    std::vector<block_cq8_0> a(n/QK_CQ8_0);
+    quantize_row_cq3_0_ref(weights.data(), w0.data(), n);
+    quantize_row_cq3_0_ref(weights.data(), w1.data(), n);
+    quantize_row_cq8_0_ref(activations.data(), a.data(), n);
+    assert(std::memcmp(w0.data(), w1.data(), w0.size()*sizeof(block_cq3_0)) == 0);
+
+    float scalar = 0.0f;
+    float dispatched = 0.0f;
+#if defined(__x86_64__) || defined(__i386__) || defined(_M_IX86) || defined(_M_X64)
+    ggml_vec_dot_cq3_0_cq8_0_generic(n, &scalar, 0, w0.data(), 0, a.data(), 0, 1);
+#else
+    ggml_vec_dot_cq3_0_cq8_0(n, &scalar, 0, w0.data(), 0, a.data(), 0, 1);
+#endif
+    ggml_vec_dot_cq3_0_cq8_0(n, &dispatched, 0, w0.data(), 0, a.data(), 0, 1);
+    const float tolerance = 2e-5f*(1.0f + std::fabs(scalar));
+    assert(std::fabs(dispatched - scalar) <= tolerance);
+
+    std::vector<float> decoded_w(n);
+    std::vector<float> decoded_a(n);
+    dequantize_row_cq3_0(w0.data(), decoded_w.data(), n);
+    dequantize_row_cq8_0(a.data(), decoded_a.data(), n);
+    double reference = 0.0;
+    for (int j = 0; j < n; ++j) {
+        reference += (double)decoded_w[j]*(double)decoded_a[j];
+    }
+    assert(std::fabs(scalar - (float)reference) <= 2e-5f*(1.0f + std::fabs((float)reference)));
+}
+
+int main() {
+    ggml_cpu_init();
+    test_layout_and_decode();
+    test_activation_contract();
+    test_determinism_and_dot();
+    return 0;
+}
