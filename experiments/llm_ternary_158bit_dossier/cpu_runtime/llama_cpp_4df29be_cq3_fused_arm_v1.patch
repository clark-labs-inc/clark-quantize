+void ggml_gemv_cq3_0_cq8_0_pair_arm(
+        int n,
+        float * GGML_RESTRICT gate,
+        float * GGML_RESTRICT up,
+        const void * GGML_RESTRICT vx_gate,
+        size_t bx_gate,
+        const void * GGML_RESTRICT vx_up,
+        size_t bx_up,
+        const void * GGML_RESTRICT vy,
+        int nr) {
+    assert(n % QK_CQ3_0 == 0);
+    assert(nr > 0 && nr <= 8);
+#if defined(__ARM_NEON)
+    const block_cq8_0 * GGML_RESTRICT y = vy;
+    const int nb = n / QK_CQ3_0;
+    const uint8x16_t mask = vdupq_n_u8(3);
+    float32x4_t gate_sums[8];
+    float32x4_t up_sums[8];
+    const block_cq3_0 * gate_rows[8];
+    const block_cq3_0 * up_rows[8];
+    for (int row = 0; row < nr; ++row) {
+        gate_sums[row] = vdupq_n_f32(0.0f);
+        up_sums[row] = vdupq_n_f32(0.0f);
+        gate_rows[row] = (const block_cq3_0 *) ((const char *) vx_gate + row*bx_gate);
+        up_rows[row] = (const block_cq3_0 *) ((const char *) vx_up + row*bx_up);
+    }
+
+    for (int ib = 0; ib < nb; ++ib) {
+        for (int group = 0; group < 2; ++group) {
+            const block_cq8_0 * activation = y + 2*ib + group;
+            const int8_t * values = activation->qs;
+            const int8x16_t y0 = vld1q_s8(values);
+            const int8x16_t y1 = vld1q_s8(values + 16);
+            const int8x16_t y2 = vld1q_s8(values + 32);
+            const int8x16_t y3 = vld1q_s8(values + 48);
+            const int8x16_t y4 = vld1q_s8(values + 64);
+            const int8x16_t y5 = vld1q_s8(values + 80);
+            const int8x16_t y6 = vld1q_s8(values + 96);
+            const int8x16_t y7 = vld1q_s8(values + 112);
+            for (int row = 0; row < nr; ++row) {
+                const int32x4_t gate_dot = ggml_cq3_dot_group_arm(
+                    gate_rows[row][ib].qs + group*32, mask,
+                    y0, y1, y2, y3, y4, y5, y6, y7, activation->sum);
+                const int32x4_t up_dot = ggml_cq3_dot_group_arm(
+                    up_rows[row][ib].qs + group*32, mask,
+                    y0, y1, y2, y3, y4, y5, y6, y7, activation->sum);
+                gate_sums[row] = vmlaq_n_f32(
+                    gate_sums[row], vcvtq_f32_s32(gate_dot),
+                    GGML_CPU_FP16_TO_FP32(gate_rows[row][ib].d[group])*activation->d);
+                up_sums[row] = vmlaq_n_f32(
+                    up_sums[row], vcvtq_f32_s32(up_dot),
+                    GGML_CPU_FP16_TO_FP32(up_rows[row][ib].d[group])*activation->d);
+            }
+        }
+    }
+    for (int row = 0; row < nr; ++row) {
+        gate[row] = ggml_cq3_reduce_arm(gate_sums[row]);
+        up[row] = ggml_cq3_reduce_arm(up_sums[row]);
+    }
+#else
+    for (int row = 0; row < nr; ++row) {
+        ggml_vec_dot_cq3_0_cq8_0_generic(
+            n, gate + row, 0, (const char *) vx_gate + row*bx_gate, 0, vy, 0, 1);
+        ggml_vec_dot_cq3_0_cq8_0_generic(
+            n, up + row, 0, (const char *) vx_up + row*bx_up, 0, vy, 0, 1);
+    }
+#endif
+}
