[Unit]
Description=Conditionally build the complete Qwen3.8-27B aligned-2 CPU cache
After=network-online.target quant-qwen38-27b-aligned2-cache-watch-v1.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-7e17343.bundle
Environment=EXPECTED_COMMIT=7e1734308d3d920f4ba2a53f38a8df004dd89552
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch-qwen38-27b-aligned2-full-cache-v1-7e17343.sh
CPUQuota=400%
MemoryMax=4G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
