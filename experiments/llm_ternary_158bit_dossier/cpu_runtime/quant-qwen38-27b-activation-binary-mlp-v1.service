[Unit]
Description=Fit a complete activation-calibrated Qwen3.8-27B binary-residual MLP
After=network-online.target quant-qwen38-27b-binary-low-rank-residual-v1.service
Before=quant-qwen38-27b-llamacpp-ternary-controls-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-activation-binary-mlp-v1
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-activation-binary-mlp.bundle
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch_qwen38_27b_activation_binary_mlp_v1.sh
CPUQuota=800%
MemoryMax=24G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target

