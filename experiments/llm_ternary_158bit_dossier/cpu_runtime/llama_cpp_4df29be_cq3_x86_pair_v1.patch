+#if defined(__x86_64__) || defined(__i386__) || defined(_M_IX86) || defined(_M_X64)
+static void test_x86_paired_gemv() {
+    constexpr int n = 4096;
+    constexpr int rows = 5;
+    std::vector<float> gate_weights(rows*n);
+    std::vector<float> up_weights(rows*n);
+    std::vector<float> activations(n);
+    for (int j = 0; j < n; ++j) {
+        activations[j] = 1.9f*std::cos(0.019f*(float)j) - 0.23f*std::sin(0.083f*(float)j);
+        for (int row = 0; row < rows; ++row) {
+            gate_weights[row*n + j] =
+                (1.1f + 0.03f*(float)row)*std::sin((0.011f + 0.0001f*(float)row)*(float)j)
+                + 0.29f*std::cos(0.067f*(float)(j + row));
+            up_weights[row*n + j] =
+                (0.9f + 0.02f*(float)row)*std::cos((0.017f + 0.0002f*(float)row)*(float)j)
+                - 0.21f*std::sin(0.053f*(float)(j + 2*row));
+        }
+    }
+
+    const int blocks_per_row = n/QK_CQ3_0;
+    std::vector<block_cq3_0> packed_gate(rows*blocks_per_row);
+    std::vector<block_cq3_0> packed_up(rows*blocks_per_row);
+    std::vector<block_cq8_0> activation(n/QK_CQ8_0);
+    for (int row = 0; row < rows; ++row) {
+        quantize_row_cq3_0_ref(
+            gate_weights.data() + row*n, packed_gate.data() + row*blocks_per_row, n);
+        quantize_row_cq3_0_ref(
+            up_weights.data() + row*n, packed_up.data() + row*blocks_per_row, n);
+    }
+    quantize_row_cq8_0_ref(activations.data(), activation.data(), n);
+
+    std::vector<float> expected_gate(rows);
+    std::vector<float> expected_up(rows);
+    std::vector<float> actual_gate(rows);
+    std::vector<float> actual_up(rows);
+    for (int row = 0; row < rows; ++row) {
+        ggml_vec_dot_cq3_0_cq8_0(
+            n, expected_gate.data() + row, 0,
+            packed_gate.data() + row*blocks_per_row, 0,
+            activation.data(), 0, 1);
+        ggml_vec_dot_cq3_0_cq8_0(
+            n, expected_up.data() + row, 0,
+            packed_up.data() + row*blocks_per_row, 0,
+            activation.data(), 0, 1);
