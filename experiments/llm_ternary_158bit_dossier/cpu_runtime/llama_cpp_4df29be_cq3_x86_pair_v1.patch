 #endif
 }
 
+#if defined(__AVX2__)
+static inline __m256i ggml_cq3_dot_group_x86(
+        const uint8_t * GGML_RESTRICT packed_values,
+        const __m256i mask,
+        const __m256i ones,
+        const __m256i values0,
+        const __m256i values1,
+        const __m256i values2,
+        const __m256i values3,
+        const int32_t activation_sum) {
+    const __m256i packed = _mm256_loadu_si256((const __m256i *) packed_values);
+    const __m256i digits0 = _mm256_and_si256(packed, mask);
+    const __m256i digits1 = _mm256_and_si256(_mm256_srli_epi16(packed, 2), mask);
+    const __m256i digits2 = _mm256_and_si256(_mm256_srli_epi16(packed, 4), mask);
+    const __m256i digits3 = _mm256_and_si256(_mm256_srli_epi16(packed, 6), mask);
+    const __m256i products01 = _mm256_add_epi16(
+        _mm256_maddubs_epi16(digits0, values0),
+        _mm256_maddubs_epi16(digits1, values1));
+    const __m256i products23 = _mm256_add_epi16(
+        _mm256_maddubs_epi16(digits2, values2),
+        _mm256_maddubs_epi16(digits3, values3));
+    __m256i accumulator = _mm256_madd_epi16(
+        _mm256_add_epi16(products01, products23), ones);
+    return _mm256_sub_epi32(
+        accumulator,
+        _mm256_set_epi32(0, 0, 0, 0, 0, 0, 0, activation_sum));
+}
+#endif
+
+void ggml_gemv_cq3_0_cq8_0_pair_x86(
+        int n,
+        float * GGML_RESTRICT gate,
+        float * GGML_RESTRICT up,
+        const void * GGML_RESTRICT vx_gate,
+        size_t bx_gate,
+        const void * GGML_RESTRICT vx_up,
+        size_t bx_up,
+        const void * GGML_RESTRICT vy,
+        int nr) {
+    assert(n % QK_CQ3_0 == 0);
+    assert(nr > 0 && nr <= 4);
+#if defined(__AVX2__)
+    const block_cq8_0 * GGML_RESTRICT y = vy;
+    const int nb = n / QK_CQ3_0;
+    const __m256i mask = _mm256_set1_epi8(3);
+    const __m256i ones = _mm256_set1_epi16(1);
+    __m256 gate_sums[4];
+    __m256 up_sums[4];
+    const block_cq3_0 * gate_rows[4];
+    const block_cq3_0 * up_rows[4];
+    for (int row = 0; row < nr; ++row) {
+        gate_sums[row] = _mm256_setzero_ps();
+        up_sums[row] = _mm256_setzero_ps();
+        gate_rows[row] = (const block_cq3_0 *) ((const char *) vx_gate + row*bx_gate);
+        up_rows[row] = (const block_cq3_0 *) ((const char *) vx_up + row*bx_up);
+    }
+
+    for (int ib = 0; ib < nb; ++ib) {
+        for (int group = 0; group < 2; ++group) {
+            const block_cq8_0 * activation = y + 2*ib + group;
+            const int8_t * values = activation->qs;
+            const __m256i values0 = _mm256_loadu_si256((const __m256i *)(values + 0));
+            const __m256i values1 = _mm256_loadu_si256((const __m256i *)(values + 32));
+            const __m256i values2 = _mm256_loadu_si256((const __m256i *)(values + 64));
+            const __m256i values3 = _mm256_loadu_si256((const __m256i *)(values + 96));
+            for (int row = 0; row < nr; ++row) {
+                const __m256i gate_dot = ggml_cq3_dot_group_x86(
+                    gate_rows[row][ib].qs + group*32, mask, ones,
+                    values0, values1, values2, values3, activation->sum);
+                const __m256i up_dot = ggml_cq3_dot_group_x86(
+                    up_rows[row][ib].qs + group*32, mask, ones,
+                    values0, values1, values2, values3, activation->sum);
+                const __m256 gate_scale = _mm256_set1_ps(
+                    GGML_CPU_FP16_TO_FP32(gate_rows[row][ib].d[group])*activation->d);
+                const __m256 up_scale = _mm256_set1_ps(
+                    GGML_CPU_FP16_TO_FP32(up_rows[row][ib].d[group])*activation->d);
+#if defined(__FMA__)
+                gate_sums[row] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(gate_dot), gate_scale, gate_sums[row]);
+                up_sums[row] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(up_dot), up_scale, up_sums[row]);
+#else
+                gate_sums[row] = _mm256_add_ps(
+                    gate_sums[row], _mm256_mul_ps(_mm256_cvtepi32_ps(gate_dot), gate_scale));
+                up_sums[row] = _mm256_add_ps(
+                    up_sums[row], _mm256_mul_ps(_mm256_cvtepi32_ps(up_dot), up_scale));
+#endif
+            }
+        }
+    }
+    for (int row = 0; row < nr; ++row) {
+        gate[row] = hsum_float_8(gate_sums[row]);
+        up[row] = hsum_float_8(up_sums[row]);
+    }
+#else
+    for (int row = 0; row < nr; ++row) {
+        ggml_vec_dot_cq3_0_cq8_0_generic(
+            n, gate + row, 0, (const char *) vx_gate + row*bx_gate, 0, vy, 0, 1);
+        ggml_vec_dot_cq3_0_cq8_0_generic(
+            n, up + row, 0, (const char *) vx_up + row*bx_up, 0, vy, 0, 1);
+    }
+#endif
+}
