[Unit]
Description=Fit Qwen3.8-27B Clark-Hash residual coefficients on real activations
After=network-online.target quant-qwen38-27b-hash-residual-screen-v1.service quant-qwen38-27b-static-entropy-full-v1.service
Before=quant-qwen38-27b-layer0-mlp-activation-qat-watch-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-activation-hash.bundle
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch_qwen38_27b_activation_hash_residual_v1.sh
CPUQuota=400%
MemoryMax=10G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
