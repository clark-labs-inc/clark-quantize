After=network-online.target quant-qwen38-27b-layer0-mlp-activation-qat-paired-watch-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-ed071f5.bundle
Environment=EXPECTED_COMMIT=ed071f569d44fa6b16e78994a3fef9893ab91c0c
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch-qwen38-27b-row-normalized-scale-codebook4-v1-ed071f5.sh
