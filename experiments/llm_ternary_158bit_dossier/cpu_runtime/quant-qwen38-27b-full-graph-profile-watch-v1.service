[Unit]
Description=Profile projection time across the Qwen3.8-27B full text graph
After=network-online.target quant-qwen38-27b-persistent-affinity-watch-v1.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-e86537b.bundle
Environment=EXPECTED_COMMIT=e86537b1aac316919a6da5bd782d11965b713070
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/bin/bash /workspace/tmp/watch-qwen38-27b-full-graph-profile-v1-e86537b.sh
CPUAffinity=0 2 4 6
CPUQuota=400%
MemoryMax=12G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
