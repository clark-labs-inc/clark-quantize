[Unit]
Description=Run the complete Qwen3.8-27B aligned-2 text graph
After=network-online.target quant-qwen38-27b-aligned2-real-layers-watch-v1.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-c4ee934.bundle
Environment=EXPECTED_COMMIT=c4ee934e773a3dad72db743c9cf4b8fdf6b82e91
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/bin/bash /workspace/tmp/watch-qwen38-27b-aligned2-full-text-v1-c4ee934.sh
CPUAffinity=0 2 4 6
CPUQuota=400%
MemoryMax=12G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
