[Unit]
Description=Benchmark direct Qwen3.8-27B block203 row-scale4 AVX2 kernel
After=network-online.target quant-qwen38-27b-row-scale4-kernel-watch-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-f10ac9c.bundle
Environment=EXPECTED_COMMIT=f10ac9cf65a5cb5291d795f7e4c2fd12a9b2b3f7
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch-qwen38-27b-block203-row-scale4-direct-gemv-v1-f10ac9c.sh
CPUQuota=100%
MemoryMax=8G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
