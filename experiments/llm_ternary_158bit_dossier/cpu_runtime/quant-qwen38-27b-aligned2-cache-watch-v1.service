[Unit]
Description=Gate a derived aligned-2 CPU cache for Qwen3.8-27B
After=network-online.target quant-qwen38-27b-cq3-layer0-mlp-watch-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-3bdfffe.bundle
Environment=EXPECTED_COMMIT=3bdfffe51d695373f29be7eafd057ce487e2ee70
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch-qwen38-27b-aligned2-cache-v1-3bdfffe.sh
CPUQuota=400%
MemoryMax=4G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
