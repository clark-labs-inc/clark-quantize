[Unit]
Description=Audit complete half-support plus hash storage for Qwen3.8-27B
After=network-online.target quant-qwen38-27b-half-support-tail-hash-fused-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-half-support-ledger.bundle
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch_qwen38_27b_half_support_complete_ledger_v1.sh
CPUQuota=100%
MemoryMax=512M
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
