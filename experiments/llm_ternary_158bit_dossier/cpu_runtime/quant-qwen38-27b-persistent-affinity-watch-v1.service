[Unit]
Description=Benchmark persistent worker affinity on Qwen3.8-27B full text graph
After=network-online.target quant-qwen38-27b-aligned2-prefill-skip-lm-head-watch-v1.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-ee58de1.bundle
Environment=EXPECTED_COMMIT=ee58de1f24f2dd3f226045aa2d8f42cc2c07d40a
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/bin/bash /workspace/tmp/watch-qwen38-27b-persistent-affinity-v1-ee58de1.sh
CPUAffinity=0 2 4 6
CPUQuota=400%
MemoryMax=12G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
