[Unit]
Description=Benchmark exact native fixed-support coding on Qwen3.8 dimensions
After=network-online.target quant-qwen38-27b-layer0-mlp-activation-qat-paired-watch-v1.service
Before=quant-qwen38-27b-learned-hash-routing-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-fixed-support-cpu.bundle
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch_qwen38_27b_fixed_support_cpu_v1.sh
CPUQuota=100%
MemoryMax=512M
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
