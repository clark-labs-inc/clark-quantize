[Unit]
Description=Screen gain-aware Clark Hash routing on Qwen3.8-27B heldout rows
After=network-online.target quant-qwen38-27b-half-support-complete-ledger-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-gain-hash.bundle
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch_qwen38_27b_gain_hash_routing_v1.sh
CPUQuota=400%
MemoryMax=2G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
