[Unit]
Description=Benchmark Qwen3.8-27B row-scale4 AVX2 kernel after full static pass
After=network-online.target quant-qwen38-27b-full-row-normalized-scale-codebook4-watch-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-7e17343.bundle
Environment=EXPECTED_COMMIT=7e1734308d3d920f4ba2a53f38a8df004dd89552
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch-qwen38-27b-row-scale4-kernel-v1-7e17343.sh
CPUQuota=100%
MemoryMax=8G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
