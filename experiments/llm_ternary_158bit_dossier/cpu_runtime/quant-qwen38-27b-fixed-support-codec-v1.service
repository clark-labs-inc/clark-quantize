[Unit]
Description=Export exact fixed-support Qwen3.8-27B hash-residual codes
After=network-online.target quant-qwen38-27b-hash-residual-screen-v1.service
Before=quant-qwen38-27b-hash-residual-cpu-v1.service quant-qwen38-27b-activation-hash-residual-v1.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/clark-quantize-cpu-qat
Environment=BUNDLE=/workspace/tmp/clark-quantize-qwen38-fixed-support.bundle
Environment=PYTHON_BIN=/workspace/venvs/quant-cpu/bin/python
ExecStart=/workspace/tmp/watch_qwen38_27b_fixed_support_codec_v1.sh
CPUQuota=400%
MemoryMax=4G
MemorySwapMax=0
Nice=5
TimeoutStartSec=infinity
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
